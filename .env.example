# Copy this file to .env.local and fill in what you need.
# Never commit .env.local. It is already in .gitignore.

# ── Login (required) ──────────────────────────────────────────────────────
# The app refuses every request unless both are set. There is no default
# and no way to bypass this.
DASH_USER=
DASH_PASS=

# ── Demo (optional) ───────────────────────────────────────────────────────
# Set to 1 to enable /demo, a dashboard full of sample numbers, so you can see
# what it looks like before adding any addresses. Leave unset in production.
DEMO_MODE=

# ── Wallet addresses (all optional) ───────────────────────────────────────
# Put in the ones you want tracked. Leave any blank and that chain is
# skipped entirely. These are public receiving addresses, never private
# keys or seed phrases. The app cannot spend, sign, or move anything.
ETH_ADDRESS=
BSC_ADDRESS=
ETC_ADDRESS=
SOL_ADDRESS=
BTC_ADDRESS=
TRX_ADDRESS=
# Linea balances are read from ETH_ADDRESS. No separate variable.

# Extra BEP-20 token contracts to track on BNB Chain, comma-separated.
# Most tokens are discovered automatically; this is for ones that are not.
BSC_TOKENS=

# ── Mining pool (optional) ────────────────────────────────────────────────
# Only "2miners" is supported today. POOL_ADDRESS is the payout address you
# gave the pool. Leave POOL_ADDRESS blank to hide the mining page.
POOL=2miners
POOL_ADDRESS=

# ── Storage (optional) ────────────────────────────────────────────────────
# MongoDB Atlas connection string. Needed only for the purchase log and the
# stored mining payout history. Holdings work without it.
# The free M0 tier is enough.
MONGODB_URI=
MONGODB_DB=wallet_tracker
